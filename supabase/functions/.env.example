# Local Edge Function secrets. Copy to .env and fill with a random value.
# Minimum 32 characters each. Never commit the real secret.

# Signs short-lived admin session JWTs.
ADMIN_SESSION_JWT_SECRET=

# Server-side pepper for PBKDF2 PIN hashing. Rotating this invalidates the PIN.
ADMIN_PIN_PEPPER=

# Optional one-time bootstrap PIN (6 digits). The first successful verification
# stores its hash and clears the uninitialized state. Remove after setup.
ADMIN_INITIAL_PIN=

# PIN rate limiting. Defaults: 5 failed attempts, 15 minute lockout.
ADMIN_PIN_MAX_ATTEMPTS=5
ADMIN_PIN_LOCK_SECONDS=900
